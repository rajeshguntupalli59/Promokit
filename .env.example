# Railway PostgreSQL (set automatically when you add a Postgres plugin in Railway)
DATABASE_URL=postgresql://user:password@host:5432/railway

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_32_char_secret
NEXTAUTH_URL=https://your-app.up.railway.app

# Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key

# Razorpay (use live keys for production)
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx

# Google OAuth (optional — remove from env if not using Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App URL (used by cron warmup and password reset links)
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# Cron protection
CRON_SECRET=a_random_32_char_secret_string

# SMTP for password reset emails (optional — if not set, reset URL is logged to Railway logs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=PromoKit <your@gmail.com>

NODE_ENV=production
